DATABASE_URL=postgres://assistent:assistent@localhost:5432/assistent
OPENROUTER_API_KEY=
# Up to 3 comma-separated models with image input, in priority order; OpenRouter falls back to the
# next one when a model is saturated. Free models end in ":free".
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,thinkingmachines/inkling:free
# Pages beyond this limit are not analyzed.
ANALYSIS_MAX_PAGES=30
